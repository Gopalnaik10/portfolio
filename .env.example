# ==============================================================================
# PORTFOLIO CMS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual production values.
# NEVER commit your actual .env file with real secrets to GitHub!
# ==============================================================================

# Flask Settings
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars

# Server Settings
PORT=5000
HOST=0.0.0.0

# Database Configuration
# Local Development: sqlite:///database/portfolio.db
# Production (Render/PostgreSQL): postgresql://username:password@hostname:5432/database_name
DATABASE_URL=sqlite:///database/portfolio.db

# Initial Admin Credentials (Used ONLY on first database table creation)
# Change password immediately in the Admin Dashboard Settings after login!
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_DEFAULT_PASSWORD=change-this-password-min-12-chars

# SMTP / Email Notification Settings (Optional)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_RECIPIENT=
